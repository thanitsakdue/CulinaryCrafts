# =================================
# 🔐 SECURITY CONFIGURATION
# =================================
# JWT Secret Key - Change in production!
JWT_SECRET=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =================================
# 🤖 AI SERVICES
# =================================
# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_TEMPERATURE=0.1

# Vertex AI Search
VERTEX_AI_LOCATION=global
VERTEX_AI_SEARCH_APP_ID=your-search-app-id
VERTEX_AI_SEARCH_ENGINE_ID=your-search-engine-id

# =================================
# 📱 LINE INTEGRATION  
# =================================
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_LIFF_APP_ID=your-liff-app-id

# =================================
# 🗄️ DATABASE CONFIGURATION
# =================================
# Firestore Database
FIRESTORE_PROJECT_ID=your-firestore-project
FIRESTORE_DATABASE_ID=culinary-crafts-db

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# =================================
# 🌐 APPLICATION SETTINGS
# =================================
# Development/Production Mode
ENVIRONMENT=development
DEBUG=true

# API Configuration  
API_HOST=localhost
API_PORT=8000
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =================================
# 📊 MONITORING & LOGGING
# =================================
# Logging Level
LOG_LEVEL=INFO
LOG_FORMAT=json

# Google Cloud Monitoring
ENABLE_CLOUD_MONITORING=true
ENABLE_CLOUD_LOGGING=true

# =================================
# 🔒 SECURITY HEADERS
# =================================
SECURITY_HEADERS_ENABLED=true
ALLOWED_HOSTS=localhost,your-domain.com
TRUSTED_PROXIES=127.0.0.1