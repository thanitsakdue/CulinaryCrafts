# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# NextAuth Configuration
# ============================================
# Secret key for signing cookies (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-characters

# Your application URL
NEXTAUTH_URL=http://localhost:3000

# Enable debug logging (set to true for development only)
NEXTAUTH_DEBUG=false

# ============================================
# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Backend API Configuration
# ============================================
# URL where FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================
# Optional: Firebase Configuration
# (For future Firestore integration)
# ============================================
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-app-id

# ============================================
# Optional: Feature Flags
# ============================================
# NEXT_PUBLIC_ENABLE_VOICE_INPUT=false
# NEXT_PUBLIC_ENABLE_CHAT_HISTORY=true
# NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=5
